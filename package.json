{
  "name": "tonight-cinema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node server/local.mjs",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "deploy:api": "npm run catalog:prepare && wrangler deploy",
    "import:tmdb": "node scripts/import-tmdb.mjs",
    "catalog:prepare": "node scripts/prepare-catalog.mjs",
    "predev": "npm run catalog:prepare",
    "prebuild": "npm run catalog:prepare",
    "import:quality": "node scripts/import-quality.mjs",
    "import:expansion": "node scripts/import-expansion.mjs",
    "import:douban-quality": "node scripts/import-douban-quality.mjs",
    "import:series": "node scripts/import-tmdb-series.mjs",
    "embeddings": "node scripts/build-embeddings.mjs",
    "import:recent": "node scripts/import-recent.mjs",
    "backfill:details": "node scripts/backfill-details.mjs",
    "catalog:curate": "node scripts/curate-catalog.mjs",
    "eval": "node scripts/eval-retrieve.mjs",
    "import:watch": "node scripts/import-watch.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.52.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "vite": "^8.3.3",
    "wrangler": "^4.147.0"
  }
}
