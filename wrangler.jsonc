{
  "name": "tonight-cinema-api",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-09-20",
  "vars": {
    "ALLOWED_ORIGIN": "https://emanon4.github.io",
    "CATALOG_VERSION": "cebabfc710102ef7",
    "CATALOG_COUNT": 22296
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BUDGET",
        "class_name": "Budget"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Budget"
      ]
    }
  ],
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": ".cache/worker-assets",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
